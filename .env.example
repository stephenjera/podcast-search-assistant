POSTGRES_USER=docker
POSTGRES_INITDB_ARGS="--username=docker"
POSTGRES_PW=docker
POSTGRES_DB=postgres
PGADMIN_MAIL=test@mail.com
PGADMIN_PW=docker
# App (shared by core/pipeline/backend/eval)
DATABASE_URL=postgres://docker:docker@localhost:5432/postgres
EMBEDDING_MODEL=qwen3-embedding:8b
OLLAMA_URL=http://localhost:11434
TRANSCRIPTION_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SEARCH_MIN_SCORE=0.44
# PODCAST_DATA_ROOT=<repo>/data
